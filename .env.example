# Copy this file to `.env` (already .gitignored) and fill in real values for a
# production deployment. Postgres credentials fall back to safe local-dev defaults
# if omitted, but JWT_SECRET does not — docker-compose.yml requires it to be set,
# even for local use, so `.env` (with at least JWT_SECRET) is not optional.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse_db

# --- JWT (Warehouse.Api's JwtSettings) ---
# Required — docker-compose.yml has no fallback for this one. Any non-trivial
# string works for local dev; must be a long, random value in production. The
# checked-in appsettings.json value is a local-dev-only placeholder and must
# never be reused here.
JWT_SECRET=ReplaceThisWithYourOwnLongRandomLocalDevSecret123!
JWT_ISSUER=WarehouseApi
JWT_AUDIENCE=WarehouseClient

# --- ASP.NET Core ---
# Production disables Swagger UI (see Program.cs's IsDevelopment() check).
ASPNETCORE_ENVIRONMENT=Production

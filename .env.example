# Copy this file to `.env` (already .gitignored) and fill in real values for a
# production deployment. Postgres credentials fall back to safe local-dev defaults
# if omitted, but JWT_SECRET does not — docker-compose.yml requires it to be set,
# even for local use, so `.env` (with at least JWT_SECRET) is not optional.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse_db

# --- JWT (Warehouse.Api's JwtSettings) ---
# Required — docker-compose.yml has no fallback for this one. Any non-trivial
# string works for local dev; must be a long, random value in production. The
# checked-in appsettings.json value is a local-dev-only placeholder and must
# never be reused here.
JWT_SECRET=ReplaceThisWithYourOwnLongRandomLocalDevSecret123!
JWT_ISSUER=WarehouseApi
JWT_AUDIENCE=WarehouseClient

# --- ASP.NET Core ---
# Production disables Swagger UI (see Program.cs's IsDevelopment() check).
ASPNETCORE_ENVIRONMENT=Production

# --- Demo help panel (Warehouse.Api's DemoSettings) ---
# true serves /api/Demo/help with NO authentication and makes the in-app help panel
# render on every screen of both frontends. That endpoint publishes the demo logins
# and their passwords, the supervisor badge id, and live container/location barcodes
# read straight from the database.
#
# That is the point for the public review demo — a reviewer arrives at a login form
# with no credentials — and wrong everywhere else. Anyone who can reach the site can
# read the admin password and get full access, so only turn this on for a deployment
# whose database holds nothing you would mind publishing. Independent of
# ASPNETCORE_ENVIRONMENT above: this flag alone controls it.
DEMO_MODE=false

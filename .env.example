# Copy this file to `.env` (already .gitignored) and fill in real values for a
# production deployment. docker-compose.yml falls back to safe local-dev defaults
# for every one of these, so `.env` is optional for local use.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse_db

# --- JWT (Warehouse.Api's JwtSettings) ---
# Must be a long, random value in production — the checked-in appsettings.json
# default is a placeholder and should not be reused outside local dev.
JWT_SECRET=SuperSecretKeyForWarehouseProjectWhichNeedsToBeLongEnough123!
JWT_ISSUER=WarehouseApi
JWT_AUDIENCE=WarehouseClient

# --- ASP.NET Core ---
# Production disables Swagger UI (see Program.cs's IsDevelopment() check).
ASPNETCORE_ENVIRONMENT=Production
